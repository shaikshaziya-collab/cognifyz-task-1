<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Page Not Found | Cognifyz Feedback</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <header class="navbar">
      <div class="container nav-inner">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true">C</span>
          <span>
            <span class="brand-name">Cognifyz</span>
            <span class="brand-sub">Internship Task 1</span>
          </span>
        </a>
      </div>
    </header>

    <main class="result-page">
      <div class="container">
        <section class="result-card">
          <p class="error-code">404</p>
          <h1>Page not found</h1>
          <p class="result-copy">
            The page you are looking for does not exist or may have been moved.
          </p>
          <a class="btn-primary" href="/">Back to feedback form</a>
        </section>
      </div>
    </main>

    <footer class="footer">
      <div class="container">
        <p>Cognifyz Internship Task 1 · User Feedback Form</p>
      </div>
    </footer>
  </body>
</html>
